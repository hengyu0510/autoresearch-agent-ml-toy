# ============================================================
# AutoResearch Agent for ML - 环境变量模板
# ============================================================
# 使用方式：
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# 然后填入真实值。
#
# 安全说明：
#   .env 已被 .gitignore 排除，真实密钥严禁提交到仓库；
#   shell/系统环境中已存在的同名变量优先于 .env（不覆盖）。


# ---------- Kaggle API（下载 Kaggle 竞赛数据） ----------
# 新版（推荐）：kaggle.com -> Settings -> API -> Generate New Token
# 页面会生成形如 KGAT_xxx 的 token，填到 KAGGLE_API_TOKEN：
KAGGLE_API_TOKEN=

# 旧版（可选，仅当账号还在使用 Legacy API Credentials 时）：
# Settings -> API -> Legacy API Credentials -> Create Legacy API Key，
# 生成 kaggle.json 后将 username/key 填入：
KAGGLE_USERNAME=
KAGGLE_KEY=


# ---------- 决策大脑 LLM API（可选，默认用 rule 大脑） ----------
# 在 config.yaml 中设置 brain.type=llm 并选择 provider：
#   provider: openai      -> OpenAI 兼容接口（默认）
#   provider: anthropic   -> Anthropic Messages API（Claude）

# --- OpenAI / OpenAI 兼容端点 ---
# 注意：若系统/Codex 运行时已注入同名的 OPENAI_API_KEY，.env 中的同名值
# 会被覆盖（本项目的 load_dotenv 采用“系统变量优先”）。
# 因此外部 LLM 密钥建议用独立变量名并在 config 中显式指定，例如：
#   brain.api_key_env: DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=               # 如 gpt-4.1-mini；留空用 config.yaml 的 brain.model
OPENAI_BASE_URL=            # 默认 https://api.openai.com/v1；代理/兼容端点填这里
# OPENAI_REASONING_EFFORT=max  # 可选 low|medium|high|max；deepseek-v4-flash 常用 max

# --- Anthropic / Claude ---
# provider=anthropic 时使用；api_key_env 留空自动读取 ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=            # 如 claude-sonnet-4-5；留空用 config.yaml 的 brain.model
ANTHROPIC_BASE_URL=         # 默认 https://api.anthropic.com；代理填这里
# ANTHROPIC_REASONING_EFFORT=

# --- 通用覆盖（可选，优先于 config.yaml，低于上面的 provider 专用变量） ---
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_REASONING_EFFORT=


# ---------- 运行参数（可选覆盖） ----------
# 同时支持通过命令行 --max-steps / --seed 等覆盖，优先级：命令行 > 环境变量 > config.yaml
# AGENT_MAX_STEPS=
# AGENT_SEED=
